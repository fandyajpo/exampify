# Exampify — environment variables
#
# Transcribed from docs/DEPLOYMENT_AND_ENVIRONMENTS.md §4.1. Copy to `.env.local`
# (never commit that file) or fill the same names in Vercel for both Preview and
# Production. Every value below is a placeholder: no real secret belongs in this
# file, in tests or in the docs (§4.3).
#
# `lib/env.ts` parses these with Zod at module load and fails at boot when one is
# missing or malformed. Server and public schemas are separate, so only the
# NEXT_PUBLIC_* values may reach a client bundle.

# --- Database (Turso / libSQL) -------------------------------------------------
# libsql://… in deployed environments; file:./.data/dev.db locally.
TURSO_DATABASE_URL=libsql://your-database.turso.io
# Database-scoped token, never a Turso platform token.
TURSO_AUTH_TOKEN=replace-with-database-token

# --- Auth (Better Auth) --------------------------------------------------------
# ≥ 32 random bytes. Rotating it invalidates every session.
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
# Exact public origin, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Search (Qdrant Cloud) -----------------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-cluster-api-key
# content_v1 in production, content_preview in preview.
QDRANT_COLLECTION=content_v1

# --- Media (Tigris) ------------------------------------------------------------
TIGRIS_BUCKET=exampify-media
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_ACCESS_KEY_ID=replace-with-access-key-id
TIGRIS_SECRET_ACCESS_KEY=replace-with-secret-access-key
# Public bucket domain or custom domain, consumed by next/image (client-visible).
TIGRIS_PUBLIC_URL=https://media.example.com

# --- Jobs (Upstash QStash) -----------------------------------------------------
QSTASH_TOKEN=replace-with-qstash-publish-token
QSTASH_CURRENT_SIGNING_KEY=replace-with-current-signing-key
QSTASH_NEXT_SIGNING_KEY=replace-with-next-signing-key

# --- Rate limits and locks (Upstash Redis) -------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-rest-token

# --- Cron ----------------------------------------------------------------------
# Bearer token for /api/v1/internal/cron/* (Vercel Cron).
CRON_SECRET=replace-with-cron-bearer-token

# --- Public site ---------------------------------------------------------------
# Canonical origin for metadata, sitemap and server-authored links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (transport: @sendust/ts; relay: Google SMTP) ------------------------
# `sendust` in deployed environments, `stub` in tests and local development.
EMAIL_PROVIDER=stub
EMAIL_SMTP_HOST=smtp.gmail.com
# 465 (implicit TLS) or 587 (STARTTLS); the security mode must match.
EMAIL_SMTP_PORT=465
# tls on 465, starttls on 587.
EMAIL_SMTP_SECURE=tls
# Full Google address of the dedicated sending account.
EMAIL_SMTP_USER=no-reply@mail.example.com
# 16-character Google app password — never the account password.
EMAIL_SMTP_PASS=replace-with-16-char-app-password
# Sending alias on the verified subdomain.
EMAIL_FROM="Exampify <no-reply@mail.example.com>"

# --- Error tracking (Sentry) ---------------------------------------------------
# Empty disables the SDK locally; production fails at boot if missing.
ERROR_TRACKING_DSN=
# Build/CI only — uploads source maps and must never reach the runtime bundle.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Local-only escape hatch ---------------------------------------------------
# Never set in production (startup assertion); uncomment for local job testing.
# JOBS_DEV_BYPASS=1
